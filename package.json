{
  "private": true,
  "license": "MIT",
  "engines": {
    "npm": ">=6.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:utdal/orgchart-wordpress-plugin.git"
  },
  "devDependencies": {
    "sass": "^1.98.0"
  },
  "dependencies": {
    "html2canvas": "0.5.0-beta4",
    "orgchart": "1.3.6"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "scripts": {
    "dev": "npm run development",
    "development": "sass --style expanded public/css/source/orgchart/orgchart.scss:public/css/orgchart.css public/css/source/personlist/personlist.scss:public/css/personlist.css",
    "watch": "sass --watch --style expanded public/css/source/orgchart/orgchart.scss:public/css/orgchart.css public/css/source/personlist/personlist.scss:public/css/personlist.css",
    "watch-poll": "sass --watch --poll --style expanded public/css/source/orgchart/orgchart.scss:public/css/orgchart.css public/css/source/personlist/personlist.scss:public/css/personlist.css",
    "copy": "npm run copy_vendor",
    "copy_vendor": "cp node_modules/orgchart/dist/js/jquery.orgchart.js public/js/jquery.orgchart.js && cp node_modules/html2canvas/dist/html2canvas.min.js public/js/html2canvas.min.js"
  }
}
